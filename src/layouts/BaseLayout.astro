---
interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Sukcesy polskich sportowców zimowych' } = Astro.props;
---
<html lang="pl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <nav>
            <a href="/">Start</a>
            <a href="/sportowcy">Sportowcy</a>
        </nav>
        <main>
            <slot />
        </main>
    </body>
</html>