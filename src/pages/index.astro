---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListaDyscyplin from '@/components/ListaDyscyplin.astro';
import { getCollection } from 'astro:content';
import { czas, etykiety } from '@/utils/osiagniecia';

const [osiagniecia, sportowcy] = await Promise.all([
    getCollection('osiagniecia'),
    getCollection('sportowcy'),
]);

const poId = new Map(sportowcy.map((s) => [s.id, s] as const));
const nazwa = (id: string) => {
    const s = poId.get(id);
    return s ? `${s.data.imie} ${s.data.nazwisko}` : id;
};

const najnowsze = osiagniecia
.sort((a, b) => czas(b.data) - czas(a.data))
.slice(0, 5);

---

<BaseLayout title="Polscy sportowcy zimowi">
<h1>Sukcesy polskich sportowców zimowych</h1>
<p>Archiwum wyników z linkami do źródeł. Na tą chwilę skupiamy się do skoków narciarskich. </p>

<h2>Dyscypliny</h2>
<ListaDyscyplin />
<h2>Najnowsze wpisy</h2>
<ul>
    {osiagniecia.map((o) => (
        <li>
            <a href={`/sportowcy/${o.data.sportowcy[0].id}`}>{o.data.sportowcy[0].id}</a>
            : {o.data.rok}, {o.data.zawody}
            </li>
        ))}
    </ul>
    </BaseLayout>