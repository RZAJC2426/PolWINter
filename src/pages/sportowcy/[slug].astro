---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const sportowcy = await getCollection('sportowcy');
    return sportowcy.map((s) => ({
        params: { slug: s.id },
        props: { s },
    }));
}

const { s } = Astro.props;
const { Content } = await render(s);

const wszystkie = await getCollection('osiagniecia');
const osiagniecia = wszystkie
    .filter((o) => o.data.sportowiec.id === s.id)
    .sort((a, b) => b.data.rok - a.data.rok);
---

<html lang="pl">
    <head>
        <meta charset="utf-8" />
        <title>{s.data.imie} {s.data.nazwisko}</title>
    </head>
    <body>
        <h1>{s.data.imie} {s.data.nazwisko}</h1>
        <p>{s.data.krotkiOpis}</p>
        <Content />
        <h2>Osiągnięcia</h2>
        <ul>
            {osiagniecia.map((o) => (
                <li>{o.data.rok}: {o.data.zawody}, {o.data.konkurencja} ({o.data.wynik})</li>
            ))}
        </ul>
    </body>
    </html>