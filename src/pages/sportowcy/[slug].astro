---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Osiagniecie from '@/components/Osiagniecie.astro';
import { nazwy } from '@/data/dyscypliny';
import Okruszki from '@/components/Okruszki.astro';

export async function getStaticPaths() {
    const sportowcy = await getCollection('sportowcy');
    return sportowcy.map((s) => ({
        params: { slug: s.id },
        props: { s },
    }));
}

const zawodnicy = await getCollection('sportowcy');
const poId = new Map(zawodnicy.map((z) => [z.id, z] as const));


const { s } = Astro.props;
const { Content } = await render(s);

const wszystkie = await getCollection('osiagniecia');
const osiagniecia = wszystkie
    .filter((o) => o.data.sportowcy.some((r) => r.id === s.id))
    .sort((a, b) => b.data.rok - a.data.rok);
---

<BaseLayout title={`${s.data.imie} ${s.data.nazwisko}`} description={s.data.krotkiOpis}>
<Okruszki 
    sciezka={[
        {nazwa: 'Dyscypliny', href: '/dyscypliny' },
        {
            nazwa: nazwy[s.data.dyscyplina],
            href: `/dyscypliny/${s.data.dyscyplina}`,
        },
        { nazwa: `${s.data.imie} ${s.data.nazwisko}` },
    ]}
    />
<h1>{s.data.imie} {s.data.nazwisko}</h1>
<p>{s.data.krotkiOpis}</p>
<Content />

<h2>Osiągnięcia</h2>
<table>
    <thead>
        <tr>
            <th>Rok</th>
            <th>Zawody</th>
            <th>Wynik</th>
            <th>Żródło</th>
        </tr>
    </thead>
    <tbody>
    {osiagniecia.map((o) => {
        const partnerzy = o.data.sportowcy
        .filter((r) => r.id !== s.id)
        .map((r) => {
            const p = poId.get(r.id);
            return {
                id: r.id,
                nazwa: p ? `${p.data.imie} ${p.data.nazwisko}` : r.id,
            };
        });

        return (
        <Osiagniecie
            rok={o.data.rok}
            zawody={o.data.zawody}
            miejsce={o.data.miejsce}
            konkurencja={o.data.konkurencja}
            wynik={o.data.wynik}
            zrodlo={o.data.zrodlo}
            partnerzy={partnerzy}
            />
        );
    })}
        </tbody>
    </table>

    </BaseLayout>
